# 本地开发扩展配置模板
# 仅 `pnpm dev` 生效，优先级高于已保存的扩展配置；不会被写入正式构建产物

# GitHub Personal Access Token（需 repo 权限）
VITE_GITHUB_TOKEN=

# 书签仓库 owner / name
VITE_REPO_OWNER=
VITE_REPO_NAME=my-bookmarks-test

# 同步/拉取默认文件名（bookmarks-[name].json 或旧版 bookmarks.json）
VITE_SYNC_FILE_NAME=
VITE_PULL_FILE_NAME=

# 应用差异后是否清理空文件夹（true/false）
VITE_CLEAN_EMPTY_FOLDERS=true

# 定时同步间隔（分钟，0 表示禁用）
VITE_AUTO_SYNC_INTERVAL=0
